{
    "compilerOptions": {
        "allowJs": true,
        "allowSyntheticDefaultImports": true,
        "checkJs": false,
        "declaration": true,
        "declarationDir": "dist",
        "emitDeclarationOnly": true,
        "lib": ["ES2020"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "rootDir": "src",
        "skipLibCheck": true,
        "strict": true,
        "target": "ESNext",
        "types": ["node"]
    },
    "exclude": ["node_modules/", "dist/", "test/"],
    "include": ["src/**/*.js"]
}
